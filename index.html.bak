<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f8fc">
  <title>Orbit — Chat</title>
  <style>
    :root{color-scheme:light;--ink:#20243b;--muted:#85899f;--line:#eceef5;--purple:#7258e8;--purple-dark:#6248d8;--panel:#fff;--page:#f7f8fc}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--page);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input{font:inherit}button{color:inherit}
    .app{min-height:100vh;display:grid;grid-template-columns:270px minmax(0,1fr);max-width:1600px;margin:auto;background:var(--panel);box-shadow:0 0 80px #252a4510}.sidebar{display:flex;flex-direction:column;padding:25px 16px 18px;border-right:1px solid var(--line);background:#fdfdff}.brand{display:flex;align-items:center;gap:11px;padding:0 11px 26px;font-size:19px;font-weight:750;letter-spacing:-.5px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;color:white;background:linear-gradient(145deg,#9b7cff,#644cde);box-shadow:0 5px 12px #7258e83d}.brand-mark svg{width:19px;height:19px}
    .new-chat{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:11px 12px;border:1px solid #e9e5fb;border-radius:11px;color:var(--purple-dark);background:#f5f2ff;font-weight:650;cursor:pointer;transition:background .2s,transform .2s}.new-chat:hover{background:#eeebff;transform:translateY(-1px)}.section-label{margin:27px 11px 10px;color:#a0a3b3;font-size:11px;font-weight:750;letter-spacing:1px;text-transform:uppercase}.history{display:grid;gap:4px}.history-item{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:9px;color:#666b83;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.history-item svg{flex:0 0 16px;color:#9a9db0}.history-item:hover,.history-item.active{background:#f3f1fc;color:var(--purple-dark)}.sidebar-bottom{margin-top:auto;padding-top:20px}.upgrade{display:flex;align-items:flex-start;gap:11px;padding:13px;border:1px solid #eeeafc;border-radius:12px;background:linear-gradient(135deg,#faf8ff,#f4f1ff)}.upgrade-icon{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:9px;color:#7359e8;background:white}.upgrade strong{display:block;font-size:12px}.upgrade p{margin:3px 0 0;color:var(--muted);font-size:11px;line-height:1.45}.profile{display:flex;align-items:center;gap:10px;padding:18px 7px 0}.avatar{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:50%;color:white;background:linear-gradient(145deg,#f3ac9c,#d8798a);font-size:12px;font-weight:700}.profile-name{font-size:12px;font-weight:650}.profile-plan{color:var(--muted);font-size:11px}
    .main{display:flex;min-width:0;flex-direction:column;min-height:100vh}.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 34px;border-bottom:1px solid var(--line)}.model-select{display:flex;align-items:center;gap:8px;padding:7px 10px;border:0;border-radius:8px;background:transparent;font-weight:650;cursor:pointer}.model-select:hover{background:#f6f6fb}.model-dot{width:8px;height:8px;border-radius:50%;background:#6ac6a3;box-shadow:0 0 0 3px #e5f7ef}.top-actions{display:flex;gap:8px}.icon-button{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:9px;color:#747990;background:transparent;cursor:pointer}.icon-button:hover{color:var(--ink);background:#f4f5f9}.conversation{width:min(810px,100%);flex:1;margin:0 auto;padding:34px 30px 20px}.welcome{display:flex;flex-direction:column;align-items:center;padding:10vh 0 30px;text-align:center}.welcome-orb{display:grid;place-items:center;width:58px;height:58px;margin-bottom:19px;border-radius:19px;color:white;background:linear-gradient(145deg,#a68bff,#7056e8);box-shadow:0 12px 28px #7258e83b}.welcome-orb svg{width:28px;height:28px}h1{margin:0;font-size:30px;line-height:1.2;letter-spacing:-1px}.welcome>p{max-width:430px;margin:10px 0 27px;color:var(--muted)}.suggestions{display:grid;width:min(620px,100%);grid-template-columns:1fr 1fr;gap:11px;text-align:left}.suggestion{min-height:82px;padding:13px 15px;border:1px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;transition:border-color .2s,box-shadow .2s,transform .2s}.suggestion:hover{transform:translateY(-2px);border-color:#d8d0fa;box-shadow:0 6px 18px #38305c0b}.suggestion strong{display:block;margin-bottom:3px;font-size:12px}.suggestion span{color:var(--muted);font-size:12px}
    .messages{display:grid;gap:24px;padding:8px 0 24px}.message{display:grid;grid-template-columns:34px minmax(0,1fr);gap:12px;animation:appear .22s ease-out}@keyframes appear{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}.message .avatar{width:32px;height:32px;flex-basis:32px;font-size:11px}.message .avatar.assistant{border-radius:10px;background:linear-gradient(145deg,#a68bff,#7056e8)}.message-body{min-width:0;padding-top:4px;white-space:pre-wrap;overflow-wrap:anywhere}.message-meta{margin-bottom:5px;font-size:12px;font-weight:700}.message-text{color:#52576d;line-height:1.7}.typing{display:flex;gap:4px;padding:8px 0}.typing i{width:6px;height:6px;border-radius:50%;background:#a7a1bf;animation:bop 1s infinite ease-in-out}.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}@keyframes bop{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-4px);opacity:1}}
    .composer-area{width:min(810px,100%);margin:0 auto;padding:10px 30px 22px}.composer{padding:12px 13px 10px 17px;border:1px solid #e5e6ee;border-radius:15px;background:#fff;box-shadow:0 8px 28px #22243a0b;transition:border-color .2s,box-shadow .2s}.composer:focus-within{border-color:#cfc5f7;box-shadow:0 8px 28px #7258e814}.composer textarea{display:block;width:100%;min-height:44px;max-height:180px;resize:none;padding:3px 0;border:0;outline:0;color:var(--ink);background:transparent;line-height:1.55}.composer textarea::placeholder{color:#a3a6b6}.composer-tools{display:flex;align-items:center;justify-content:space-between}.tool-group{display:flex;align-items:center;gap:5px}.tool-button{display:flex;align-items:center;gap:6px;height:31px;padding:0 8px;border:0;border-radius:7px;color:#898da1;background:transparent;font-size:11px;cursor:pointer}.tool-button:hover{color:#5d6177;background:#f5f5f9}.send{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:9px;color:white;background:var(--purple);cursor:pointer;transition:background .2s,transform .2s}.send:hover{background:var(--purple-dark);transform:translateY(-1px)}.send:disabled{background:#c8c3d9;cursor:not-allowed;transform:none}.footnote{margin:9px 0 0;color:#a2a5b4;font-size:10px;text-align:center}
    @media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{display:none}.topbar{height:60px;padding:0 16px}.conversation{padding:25px 18px 12px}.welcome{padding-top:8vh}h1{font-size:26px}.composer-area{padding:8px 14px 14px}}@media(max-width:420px){.suggestions{grid-template-columns:1fr;gap:8px}.suggestion{min-height:70px}.tool-button.optional{display:none}}
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar" aria-label="Chat sidebar">
      <div class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 14.3 9.7 21.2 12l-6.9 2.3-2.3 6.9-2.3-6.9L2.8 12l6.9-2.3L12 2.8Z" fill="currentColor"/><path d="m19 2 .8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8L19 2Z" fill="currentColor"/></svg></span>orbit</div>
      <button class="new-chat" id="newChat"><span aria-hidden="true">＋</span> New chat</button>
      <div class="section-label">Recent</div>
      <nav class="history" id="history">
        <div class="history-item active"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4.7A2.7 2.7 0 0 1 6.7 2h8.6A2.7 2.7 0 0 1 18 4.7v6.6a2.7 2.7 0 0 1-2.7 2.7H9l-4 3v-3.3a2.7 2.7 0 0 1-1-2.1V4.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Getting started with Orbit</span></div>
        <div class="history-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4.7A2.7 2.7 0 0 1 6.7 2h8.6A2.7 2.7 0 0 1 18 4.7v6.6a2.7 2.7 0 0 1-2.7 2.7H9l-4 3v-3.3a2.7 2.7 0 0 1-1-2.1V4.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Ideas for a weekend trip</span></div>
        <div class="history-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4.7A2.7 2.7 0 0 1 6.7 2h8.6A2.7 2.7 0 0 1 18 4.7v6.6a2.7 2.7 0 0 1-2.7 2.7H9l-4 3v-3.3a2.7 2.7 0 0 1-1-2.1V4.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Explain quantum computing</span></div>
        <div class="history-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4.7A2.7 2.7 0 0 1 6.7 2h8.6A2.7 2.7 0 0 1 18 4.7v6.6a2.7 2.7 0 0 1-2.7 2.7H9l-4 3v-3.3a2.7 2.7 0 0 1-1-2.1V4.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Meal prep made simple</span></div>
      </nav>
      <div class="sidebar-bottom"><div class="upgrade"><span class="upgrade-icon" aria-hidden="true">✦</span><div><strong>Make more with Orbit</strong><p>Unlock longer conversations and more ways to create.</p></div></div><div class="profile"><div class="avatar" aria-hidden="true">JD</div><div><div class="profile-name">Jordan Davis</div><div class="profile-plan">Free plan</div></div><button class="icon-button" style="margin-left:auto" aria-label="Account options"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><circle cx="4" cy="10" r="1.4"/><circle cx="10" cy="10" r="1.4"/><circle cx="16" cy="10" r="1.4"/></svg></button></div></div>
    </aside>
    <main class="main">
      <header class="topbar"><button class="model-select" aria-label="Choose model"><span class="model-dot"></span> Orbit 3.5 <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="top-actions"><button class="icon-button" aria-label="Share conversation"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M10 13V3m0 0L6.5 6.5M10 3l3.5 3.5M4 10v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button class="icon-button" aria-label="More options"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><circle cx="4" cy="10" r="1.4"/><circle cx="10" cy="10" r="1.4"/><circle cx="16" cy="10" r="1.4"/></svg></button></div></header>
      <section class="conversation" aria-live="polite">
        <div class="welcome" id="welcome"><div class="welcome-orb" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2.8 14.3 9.7 21.2 12l-6.9 2.3-2.3 6.9-2.3-6.9L2.8 12l6.9-2.3L12 2.8Z" fill="currentColor"/><path d="m19 2 .8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8L19 2Z" fill="currentColor"/></svg></div><h1>What can I help with?</h1><p>Ask a question, work through an idea, or just start a conversation.</p><div class="suggestions"><button class="suggestion" data-prompt="Help me plan a productive week"><strong>Plan my week</strong><span>Build a schedule that feels manageable</span></button><button class="suggestion" data-prompt="Explain a tricky idea in simple terms"><strong>Learn something</strong><span>Get a clear, straightforward explanation</span></button><button class="suggestion" data-prompt="Help me brainstorm a creative project"><strong>Explore an idea</strong><span>Brainstorm and find a starting point</span></button><button class="suggestion" data-prompt="Write a friendly message for me"><strong>Write something</strong><span>Get help finding just the right words</span></button></div></div>
        <div class="messages" id="messages"></div>
      </section>
      <div class="composer-area"><form class="composer" id="chatForm"><textarea id="messageInput" rows="1" aria-label="Message Orbit" placeholder="Message Orbit..."></textarea><div class="composer-tools"><div class="tool-group"><button class="tool-button" type="button" aria-label="Attach a file"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="m7.5 10.8 4.7-4.7a2.1 2.1 0 0 1 3 3l-6.7 6.7a3.6 3.6 0 0 1-5.1-5.1L10.2 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button><button class="tool-button optional" type="button"><svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M10 2v2m0 12v2M2 10h2m12 0h2M4.35 4.35l1.42 1.42m8.46 8.46 1.42 1.42m0-11.3-1.42 1.42m-8.46 8.46-1.42 1.42M13 7l-6 6m0-6 6 6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>Tools</button></div><button class="send" id="sendButton" type="submit" aria-label="Send message" disabled><svg width="17" height="17" viewBox="0 0 20 20" fill="none"><path d="M10 15V5m0 0L6 9m4-4 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></form><p class="footnote">Orbit can make mistakes. Check important information.</p></div>
    </main>
  </div>
  <script>
    const form=document.querySelector('#chatForm'),input=document.querySelector('#messageInput'),sendButton=document.querySelector('#sendButton'),messages=document.querySelector('#messages'),welcome=document.querySelector('#welcome'),history=document.querySelector('#history');
    function resizeInput(){input.style.height='auto';input.style.height=Math.min(input.scrollHeight,180)+'px';sendButton.disabled=!input.value.trim()}
    input.addEventListener('input',resizeInput);input.addEventListener('keydown',event=>{if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();if(input.value.trim())form.requestSubmit()}});
    function addMessage(text,who){const row=document.createElement('article');row.className='message';const avatar=document.createElement('div');avatar.className='avatar'+(who==='Orbit'?' assistant':'');avatar.textContent=who==='Orbit'?'✦':'JD';avatar.setAttribute('aria-hidden','true');const body=document.createElement('div');body.className='message-body';const name=document.createElement('div');name.className='message-meta';name.textContent=who;const content=document.createElement('div');content.className='message-text';content.textContent=text;body.append(name,content);row.append(avatar,body);messages.append(row);return row}
    function makeReply(prompt){const clean=prompt.trim().replace(/[.!?]+$/,'');return `I'd be happy to help with “${clean}.” This demo chat is running locally, so it doesn't connect to an AI service yet. You can customize this response or connect the interface to your own chat API.`}
    form.addEventListener('submit',event=>{event.preventDefault();const text=input.value.trim();if(!text)return;welcome.hidden=true;addMessage(text,'You');const pending=document.createElement('div');pending.className='message';pending.innerHTML='<div class="avatar assistant" aria-hidden="true">✦</div><div class="message-body"><div class="message-meta">Orbit</div><div class="typing" aria-label="Orbit is thinking"><i></i><i></i><i></i></div></div>';messages.append(pending);input.value='';resizeInput();input.focus();setTimeout(()=>{pending.remove();addMessage(makeReply(text),'Orbit');messages.lastElementChild?.scrollIntoView({behavior:'smooth',block:'nearest'})},700)});
    document.querySelectorAll('.suggestion').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.prompt;resizeInput();form.requestSubmit()}));
    document.querySelector('#newChat').addEventListener('click',()=>{messages.replaceChildren();welcome.hidden=false;input.value='';resizeInput();input.focus();history.querySelectorAll('.history-item').forEach(item=>item.classList.remove('active'))});
    history.addEventListener('click',event=>{const item=event.target.closest('.history-item');if(!item)return;history.querySelectorAll('.history-item').forEach(entry=>entry.classList.toggle('active',entry===item));if(item.textContent.trim()==='Getting started with Orbit'){messages.replaceChildren();welcome.hidden=false}});
  </script>
</body>
</html>
